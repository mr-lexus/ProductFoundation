{
  "name": "@app/mobile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build:dependencies": "pnpm --dir ../.. build:frontend-dependencies",
    "build": "node ../../scripts/run-frontend-platform.mjs mobile build",
    "cap:add:android": "cap add android",
    "cap:add:ios": "cap add ios",
    "cap:sync": "node ../../scripts/run-capacitor.mjs",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "check": "pnpm build:dependencies && pnpm check:package",
    "check:package": "tsc --noEmit",
    "build:runtime": "vite build",
    "dev:frontend": "node ../../scripts/run-frontend-platform.mjs mobile dev",
    "check:frontend": "tsc --noEmit -p tsconfig.frontend.json",
    "cap:sync:dev": "node ../../scripts/run-capacitor.mjs --development"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/ios": "^8.5.3",
    "@app/frontend-app": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sass": "^1.105.1",
    "vite": "^8.3.3"
  }
}

{
  "extends": "../../packages/config/tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "noEmit": true,
    "types": ["vite/client", "vite-plugin-pwa/react"]
  },
  "include": [
    "index.html",
    "src/**/*.ts",
    "src/**/*.tsx",
    "vite.config.ts",
    "pwa.config.ts",
    "playwright.config.ts",
    "tests/**/*.ts"
  ]
}

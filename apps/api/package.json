{
  "name": "@app/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build:dependencies": "pnpm --filter @app/contracts build && pnpm --filter @product-foundation/backend-postgres build && pnpm --filter @product-foundation/rpc-server build",
    "build": "pnpm build:dependencies && pnpm build:package",
    "build:package": "tsc -p tsconfig.build.json",
    "dev": "pnpm build:dependencies && pnpm dev:runtime",
    "dev:runtime": "node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "migrate": "node --enable-source-maps dist/app/database/migrate.js",
    "migrate:dev": "node --env-file-if-exists=../../.env --import tsx src/app/database/migrate.ts",
    "outbox:admin": "node --enable-source-maps dist/app/worker/outbox-admin.js",
    "outbox:admin:dev": "pnpm build:dependencies && node --env-file-if-exists=../../.env --import tsx src/app/worker/outbox-admin.ts",
    "start": "node --enable-source-maps dist/server.js",
    "worker": "node --enable-source-maps dist/worker.js",
    "worker:dev": "pnpm build:dependencies && node --env-file-if-exists=../../.env --import tsx src/worker.ts",
    "check": "pnpm build:dependencies && pnpm check:package",
    "check:package": "tsc --noEmit",
    "test": "pnpm test:unit",
    "test:unit": "pnpm build:dependencies && pnpm test:unit:package",
    "test:unit:package": "tsx --test src/app/http/create-nest-application.test.ts src/app/architecture/architecture-boundaries.test.ts src/shared/application/create-idempotent-rpc-handler-invoker.test.ts",
    "test:integration": "node ../../scripts/require-test-database.mjs && pnpm build:dependencies && tsx --test --test-concurrency=1 src/shared/application/durable-rpc-mutation.integration.test.ts src/app/http/reference-durable-probe.integration.test.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@app/contracts": "workspace:*",
    "@product-foundation/backend-core": "workspace:*",
    "@product-foundation/backend-postgres": "workspace:*",
    "@product-foundation/rpc-server": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.2",
    "fastify": "^5.12.5",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}

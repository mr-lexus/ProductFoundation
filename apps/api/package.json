{
  "name": "@app/api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build:dependencies": "pnpm --filter @app/contracts build && pnpm --filter @product-foundation/backend-postgres build && pnpm --filter @product-foundation/rpc-server build",
    "build": "pnpm build:dependencies && tsc -p tsconfig.build.json",
    "dev": "pnpm build:dependencies && node --env-file-if-exists=../../.env --import tsx --watch src/server.ts",
    "migrate": "node --enable-source-maps dist/app/database/migrate.js",
    "migrate:dev": "node --env-file-if-exists=../../.env --import tsx src/app/database/migrate.ts",
    "start": "node --enable-source-maps dist/server.js",
    "worker": "node --enable-source-maps dist/worker.js",
    "worker:dev": "pnpm build:dependencies && node --env-file-if-exists=../../.env --import tsx src/worker.ts",
    "check": "pnpm build:dependencies && tsc --noEmit",
    "test": "pnpm build:dependencies && tsx --test src/app/http/create-nest-application.test.ts src/app/architecture/architecture-boundaries.test.ts src/shared/application/create-idempotent-rpc-handler-invoker.test.ts src/shared/application/durable-rpc-mutation.integration.test.ts"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.0",
    "@fastify/rate-limit": "^11.1.0",
    "@app/contracts": "workspace:*",
    "@product-foundation/backend-core": "workspace:*",
    "@product-foundation/backend-postgres": "workspace:*",
    "@product-foundation/rpc-server": "workspace:*",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "fastify": "^5.0.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}

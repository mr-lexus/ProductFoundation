{
  "name": "@app/desktop",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "build": "node ../../scripts/run-tauri.mjs build",
    "build:ci": "node ../../scripts/run-tauri.mjs build --no-bundle -- --locked",
    "check": "cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "format:check": "cargo fmt --check --manifest-path src-tauri/Cargo.toml",
    "lint": "cargo clippy --locked --manifest-path src-tauri/Cargo.toml --all-targets --all-features -- -D warnings",
    "dev": "node ../../scripts/run-tauri.mjs dev",
    "build:runtime": "vite build",
    "dev:frontend": "node ../../scripts/run-frontend-platform.mjs desktop dev",
    "check:frontend": "tsc --noEmit -p tsconfig.frontend.json"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "sass": "^1.105.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "dependencies": {
    "@app/frontend-app": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Product Starter",
  "version": "0.0.0",
  "identifier": "com.example.product.desktop",
  "build": {
    "beforeBuildCommand": "pnpm --filter @app/web build",
    "beforeDevCommand": "pnpm --filter @app/web dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 860,
        "resizable": true,
        "title": "Product Starter",
        "width": 1280
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}

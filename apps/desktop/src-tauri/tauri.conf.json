{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Product Starter",
  "version": "0.0.0",
  "identifier": "com.example.product.desktop",
  "build": {
    "beforeBuildCommand": {
      "cwd": "../../..",
      "script": "pnpm build:desktop:frontend"
    },
    "beforeDevCommand": {
      "cwd": "../../..",
      "script": "pnpm dev:desktop:frontend"
    },
    "devUrl": "http://127.0.0.1:1422",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    },
    "windows": [
      {
        "height": 860,
        "resizable": true,
        "title": "Product Starter",
        "width": 1280,
        "useHttpsScheme": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}

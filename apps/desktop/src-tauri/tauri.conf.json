{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GTD Planner Desktop Demo",
  "version": "0.0.0",
  "identifier": "com.gtdplanner.desktop",
  "build": {
    "beforeBuildCommand": "pnpm --filter @gtd-planner/web build",
    "beforeDevCommand": "pnpm --filter @gtd-planner/web dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../web/dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "height": 860,
        "resizable": true,
        "title": "GTD Planner Desktop Demo",
        "width": 1280
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}

# Локальный шаблон конфигурации.
# Скопируйте файл в `.env`. Не храните здесь production-секреты:
# в production значения должны поступать из secret manager или runtime environment.

# -----------------------------------------------------------------------------
# Runtime / Режим приложения
# -----------------------------------------------------------------------------

# Режим выполнения: development, test или production.
# В production DATABASE_URL и CORS_ORIGINS обязательны.
NODE_ENV=development

# Порт, который слушает процесс NestJS API.
PORT=3001

# Уровень структурированных логов: fatal, error, warn, info, debug, trace, silent.
LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Docker Compose / Порты на локальной машине
# -----------------------------------------------------------------------------

# Host-порт API в Docker Compose. Внутри контейнера API остаётся на порту 3001.
API_PORT=3001

# Host-порт PostgreSQL в Docker Compose. При изменении обновите порт в DATABASE_URL.
DATABASE_PORT=5432

# Необязательное имя Compose-проекта для изоляции контейнеров и volumes.
# Особенно полезно, если локально запущено несколько продуктов на этом foundation.
# COMPOSE_PROJECT_NAME=product-foundation

# -----------------------------------------------------------------------------
# HTTP API / Безопасность границы
# -----------------------------------------------------------------------------

# Разрешённые browser origins через запятую, без завершающего `/`.
# В production список обязателен. Authorization и cookies требуют точного origin.
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420

# Максимальный размер RPC request body в байтах. 1048576 = 1 MiB.
MAX_RPC_BODY_BYTES=1048576

# Максимум запросов от одного client IP за RATE_LIMIT_WINDOW_MS.
# Счётчик локален для каждого процесса API и служит базовой защитой.
RATE_LIMIT_MAX=300

# Окно rate limit в миллисекундах. 60000 = 1 минута.
RATE_LIMIT_WINDOW_MS=60000

# Учитывать proxy headers при определении client IP.
# Включайте только за настроенным доверенным reverse proxy.
TRUST_PROXY=false

# -----------------------------------------------------------------------------
# Data scope / Модель владения данными
# -----------------------------------------------------------------------------

# global — общая область данных продукта.
# tenant — product repositories работают через TenantTransactionRunner.
# Выберите режим до добавления первых продуктовых таблиц.
DATA_SCOPE_MODE=global

# -----------------------------------------------------------------------------
# PostgreSQL / Миграции
# -----------------------------------------------------------------------------

# Строка подключения к локальной PostgreSQL.
# Worker требует DATABASE_URL; production API также не запустится без неё.
# Migration job использует MIGRATION_DATABASE_URL с fallback на DATABASE_URL для local development.
DATABASE_URL=postgresql://app:local_only_password@localhost:5432/app

# Отдельная privileged connection string только для migration job.
# Если не указана, local development использует DATABASE_URL. В production API/worker не должны
# получать эту переменную, а DATABASE_URL должен принадлежать least-privilege runtime role.
# MIGRATION_DATABASE_URL=postgresql://app_owner:owner_password@localhost:5432/app

# Максимальное количество PostgreSQL connections на один процесс API или worker.
# Общий бюджет соединений = значение × количество запущенных процессов.
DATABASE_POOL_MAX=10

# Максимальное ожидание подключения к PostgreSQL в миллисекундах.
DATABASE_CONNECTION_TIMEOUT_MS=5000

# Стабильный namespace продуктовых SQL-миграций в platform.schema_migrations.
# Используйте lowercase буквы, цифры, `_` или `-`; не меняйте после первого deploy.
PRODUCT_MIGRATION_NAMESPACE=app

# -----------------------------------------------------------------------------
# Background worker / Transactional outbox
# -----------------------------------------------------------------------------

# Максимальное количество outbox messages, одновременно запускаемых одним worker process.
# Значение также ограничивает размер одного claim; допустимый диапазон 1..50.
WORKER_BATCH_SIZE=10

# Максимальное количество finalized rows, удаляемых за один maintenance pass.
WORKER_CLEANUP_BATCH_SIZE=500

# Срок хранения dead-letter messages в миллисекундах. 2592000000 = 30 дней.
WORKER_DEAD_LETTER_RETENTION_MS=2592000000

# Срок владения захваченным message в миллисекундах. 30000 = 30 секунд.
# Handler должен завершиться раньше lease; долгую работу разбивайте через новые events.
WORKER_LEASE_MS=30000

# Интервал обновления worker metrics и retention cleanup. 30000 = 30 секунд.
WORKER_MAINTENANCE_INTERVAL_MS=30000

# Количество неудачных доставок до перевода message в dead letter.
WORKER_MAX_ATTEMPTS=10

# Порт worker health endpoints и Prometheus metrics:
# /health/live, /health/ready и /metrics.
WORKER_METRICS_PORT=9464

# Пауза между пустыми polls и после временной ошибки. 1000 = 1 секунда.
WORKER_POLL_INTERVAL_MS=1000

# Срок хранения успешно обработанных messages. 604800000 = 7 дней.
WORKER_PROCESSED_RETENTION_MS=604800000

# Frontend build variables (`VITE_API_URL`, `VITE_APP_PLATFORM`, `VITE_APP_TITLE`)
# передаются platform build-скриптами или через shell/CI environment. Корневой `.env`
# не следует считать frontend-конфигурацией.

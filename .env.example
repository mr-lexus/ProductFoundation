# Local development only. Production values must come from a secret manager.
NODE_ENV=development
PORT=3001
# Optional host port used by Docker Compose; container PORT remains 3001.
API_PORT=3001
CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420
DATABASE_URL=postgresql://app:local_only_password@localhost:5432/app
DATABASE_POOL_MAX=10
DATABASE_CONNECTION_TIMEOUT_MS=5000
MAX_RPC_BODY_BYTES=1048576
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY=false
LOG_LEVEL=info
WORKER_BATCH_SIZE=50
WORKER_LEASE_MS=30000
WORKER_MAX_ATTEMPTS=10
WORKER_POLL_INTERVAL_MS=1000

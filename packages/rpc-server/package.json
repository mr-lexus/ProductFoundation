  },
  "dependencies": {
    "@product-foundation/rpc": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "tsx": "^4.23.1",
    "zod": "^4.4.3",
    "typescript": "^7.0.2"
  }

{
  "name": "@product-foundation/backend-postgres",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "build:dependencies": "pnpm --filter @product-foundation/backend-core build",
    "build": "pnpm build:dependencies && pnpm build:package",
    "build:package": "tsc -p tsconfig.build.json",
    "check": "pnpm build:dependencies && pnpm check:package",
    "check:package": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:integration",
    "test:unit": "pnpm build:dependencies && pnpm test:unit:package",
    "test:unit:package": "tsx --test src/postgres-outbox-store.test.ts",
    "test:integration": "node ../../scripts/require-test-database.mjs && pnpm build:dependencies && tsx --test src/postgres.integration.test.ts"
  },
  "dependencies": {
    "@product-foundation/backend-core": "workspace:*",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
